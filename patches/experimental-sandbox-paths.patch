diff --git a/src/agents/sandbox/docker-daemon-host-paths.ts b/src/agents/sandbox/docker-daemon-host-paths.ts
new file mode 100644
--- /dev/null
+++ b/src/agents/sandbox/docker-daemon-host-paths.ts
@@ -0,0 +1,158 @@
+/**
+ * Resolves bind-mount sources for Docker daemons reached from inside a container.
+ *
+ * In Docker-outside-of-Docker, the OpenClaw gateway process sees container paths
+ * such as /home/node/.openclaw, but the Docker daemon resolves bind sources in
+ * the host namespace. Docker inspect on the gateway container provides the
+ * Source -> Destination table needed to translate those paths before creating
+ * sandbox containers.
+ */
+import os from "node:os";
+import path from "node:path";
+import { splitSandboxBindSpec } from "./bind-spec.js";
+import { isSandboxHostPathAbsolute, normalizeSandboxHostPath } from "./host-paths.js";
+
+type ExecDockerFn = (
+  args: string[],
+  opts?: { allowFailure?: boolean },
+) => Promise<{ stdout: string; stderr: string; code: number }>;
+
+type DockerInspectMount = {
+  Type?: unknown;
+  Source?: unknown;
+  Destination?: unknown;
+};
+
+export type DockerHostPathMapper = (hostPath: string) => string;
+
+type ContainerMountPathMap = {
+  source: string;
+  destination: string;
+  destinationKey: string;
+};
+
+const identityMapper: DockerHostPathMapper = (hostPath) => hostPath;
+let cachedMapper: Promise<DockerHostPathMapper> | undefined;
+
+function normalizeContainerMountPath(raw: string): string {
+  return path.posix.normalize(raw.replaceAll("\\", "/")).replace(/\/+$/, "") || "/";
+}
+
+function isContainerPathInsideMount(candidateKey: string, mountKey: string): boolean {
+  if (mountKey === "/") {
+    return candidateKey.startsWith("/");
+  }
+  return candidateKey === mountKey || candidateKey.startsWith(`${mountKey}/`);
+}
+
+function joinMappedHostPath(source: string, relative: string): string {
+  if (!relative || relative === ".") {
+    return source;
+  }
+  if (/^[A-Za-z]:[\\/]/.test(source)) {
+    return path.win32.join(source, ...relative.split("/"));
+  }
+  return path.posix.join(source, relative);
+}
+
+export function createDockerDaemonHostPathMapper(
+  mounts: readonly DockerInspectMount[],
+): DockerHostPathMapper {
+  const pathMaps: ContainerMountPathMap[] = mounts
+    .filter((mount) => {
+      const type = typeof mount.Type === "string" ? mount.Type.toLowerCase() : "";
+      return type === "bind" || type === "volume";
+    })
+    .map((mount) => {
+      const source = typeof mount.Source === "string" ? mount.Source.trim() : "";
+      const destination = typeof mount.Destination === "string" ? mount.Destination.trim() : "";
+      if (!source || !destination || !destination.startsWith("/")) {
+        return null;
+      }
+      const normalizedDestination = normalizeContainerMountPath(destination);
+      return {
+        source,
+        destination: normalizedDestination,
+        destinationKey: normalizedDestination,
+      };
+    })
+    .filter((mount): mount is ContainerMountPathMap => Boolean(mount))
+    .toSorted((left, right) => right.destinationKey.length - left.destinationKey.length);
+
+  if (pathMaps.length === 0) {
+    return identityMapper;
+  }
+
+  return (hostPath: string): string => {
+    if (!isSandboxHostPathAbsolute(hostPath)) {
+      return hostPath;
+    }
+    const normalized = normalizeContainerMountPath(hostPath);
+    const match = pathMaps.find((mount) =>
+      isContainerPathInsideMount(normalized, mount.destinationKey),
+    );
+    if (!match) {
+      return hostPath;
+    }
+    const relative = path.posix.relative(match.destination, normalized);
+    return normalizeSandboxHostPath(joinMappedHostPath(match.source, relative));
+  };
+}
+
+function parseDockerInspectMounts(raw: string): DockerInspectMount[] | null {
+  try {
+    const parsed = JSON.parse(raw);
+    return Array.isArray(parsed) ? (parsed as DockerInspectMount[]) : null;
+  } catch {
+    return null;
+  }
+}
+
+function resolveCurrentContainerInspectName(env: NodeJS.ProcessEnv): string | null {
+  return (
+    env.OPENCLAW_DOCKER_CONTAINER_ID?.trim() ||
+    env.HOSTNAME?.trim() ||
+    os.hostname().trim() ||
+    null
+  );
+}
+
+async function resolveDockerDaemonHostPathMapperUncached(params: {
+  execDocker: ExecDockerFn;
+  env?: NodeJS.ProcessEnv;
+}): Promise<DockerHostPathMapper> {
+  const inspectName = resolveCurrentContainerInspectName(params.env ?? process.env);
+  if (!inspectName) {
+    return identityMapper;
+  }
+  const result = await params.execDocker(
+    ["inspect", "-f", "{{json .Mounts}}", inspectName],
+    { allowFailure: true },
+  );
+  if (result.code !== 0) {
+    return identityMapper;
+  }
+  const mounts = parseDockerInspectMounts(result.stdout.trim());
+  return mounts ? createDockerDaemonHostPathMapper(mounts) : identityMapper;
+}
+
+export async function resolveDockerDaemonHostPathMapper(params: {
+  execDocker: ExecDockerFn;
+  env?: NodeJS.ProcessEnv;
+  cache?: boolean;
+}): Promise<DockerHostPathMapper> {
+  if (params.cache === false) {
+    return resolveDockerDaemonHostPathMapperUncached(params);
+  }
+  cachedMapper ??= resolveDockerDaemonHostPathMapperUncached(params);
+  return cachedMapper;
+}
+
+export function mapDockerBindSpecSource(spec: string, mapper: DockerHostPathMapper): string {
+  const split = splitSandboxBindSpec(spec);
+  if (!split) {
+    return spec;
+  }
+  const mappedHost = mapper(split.host);
+  return `${mappedHost}:${split.container}${split.options ? `:${split.options}` : ""}`;
+}
