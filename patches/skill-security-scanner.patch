+export function isSkillSecurityScanEnabled(env: NodeJS.ProcessEnv = process.env): boolean {
+  const raw = env.OPENCLAW_SKILL_SECURITY_SCAN;
+  if (raw === undefined) {
+    return true;
+  }
+  const parsed = parseBooleanValue(raw, {
+    truthy: ["1", "true", "on"],
+    falsy: ["0", "false", "off"],
